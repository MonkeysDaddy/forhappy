VITE_BASE=/

# 接口地址：相对路径，生产环境由 Nginx 等反向代理将 /api 转发到 ForHappy 后端
# （同 dev 的 vite 代理：location /api { proxy_pass http://<backend>:8080; }）
VITE_GLOB_API_URL=/api/v1/admin

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
